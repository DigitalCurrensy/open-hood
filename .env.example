# Public site URL for canonicals, sitemap, robots, JSON-LD, and /llms.txt.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used when this is empty.
NEXT_PUBLIC_SITE_URL=

# Optional Google Analytics 4 measurement ID (G-XXXXXXXX). Unset = no tracker, no pixels.
NEXT_PUBLIC_GA_ID=

# Optional Search Console HTML-tag verification. Unset = no meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Weekend keys — GET /api/integrations/status marks configured:true only when the real key is present
# (then probed:skip). An empty line is never configured:true. OSM remains the shop map either way.

# Photo reading. Off → on-device Tesseract. VIN decode and the quote book still work.
OPENAI_API_KEY=

# Plate-to-VIN on /history. Missing → the plate stays a note. We do not invent a VIN.
# A key does NOT go live by itself. The desk needs a DPPA / permissible-purpose checkbox.
CARSXE_API_KEY=
MARKETCHECK_API_KEY=

# Title / salvage snapshot on /history. Off → empty bay + “Not a Carfax file.”
# VINAUDIT_API_KEY or CARSXE_HISTORY_API_KEY (or CARSXE_API_KEY) → live named vendor.
# Never invents a wreck or a Carfax XML. NICB / Carfax / AutoCheck stay outbound.
VINAUDIT_API_KEY=
CARSXE_HISTORY_API_KEY=

# Directory rooftops. Missing → OSM only. Do not scrape Maps HTML.
# Key on → configured:true. /api/integrations/places and /directory merge Nearby / Fusion.
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=

# Guides. Search URLs work without it. This key lists related clips. Off → videos:[]. We do not scrape YouTube HTML.
YOUTUBE_API_KEY=

# Contact / RO window. Both required to email. Either missing → local .data/contact-submissions.jsonl (honest copy).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=Open Hood <beth.t@example.com>

# Stripe. Status: test vs live vs none.
# sk_test_ → configured:true, product:packet, checkout:true. Founder can finish a $3 print-packet /
# hold-this-bay test payment on Stripe Checkout (card 4242). Not escrow. Not a shop cut. Not marketplace.
# sk_live_ → liveKeyDetected. Packet fee ONLY if STRIPE_PACKET_PRICE_ID is a real price_ we already have.
# Without that Price ID: configured:false, product:none, checkout:false, escrow refused.
# We do not invent escrow, shop payouts, or marketplace cuts.
STRIPE_SECRET_KEY=
# STRIPE_PACKET_PRICE_ID=price_

# Request-access only until a signed contract. A key in env does NOT flip configured:true.
# PartsTech / TecDoc / MOTOR adapters stay connected:false, skus:[]. No dummy SKUs. ROADMAP.
CHROME_DATA_KEY=
TECALLIANCE_KEY=
MOTOR_API_KEY=
MITCHELL_API_KEY=
ALLDATA_API_KEY=
NMVTIS_PROVIDER_KEY=
CARAPI_API_KEY=
AUTODEV_API_KEY=
PARTSTECH_API_KEY=
CCC_API_KEY=

# Value desk. Missing → “illustration, not a Cox/KBB feed.” Present → still configured:false until a signed extract we fetch.
KBB_API_KEY=
# COX_KBB_API_KEY=

# eBay Browse. Search URLs work today. Live listings need client + secret + OAuth. Keys do not flip configured:true.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
