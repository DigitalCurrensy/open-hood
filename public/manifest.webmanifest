{
  "id": "/",
  "name": "Open Hood",
  "short_name": "Open Hood",
  "description": "Know the car. Then the window. VIN decode, quote markup, and a counter script. Pin this website — Share → Add to Home Screen. Not a shop. Not a meetup. Not on the App Store.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "background_color": "#0c1210",
  "theme_color": "#0c1210",
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "related_applications": [],
